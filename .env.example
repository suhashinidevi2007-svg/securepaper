# Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://<your-project-id>.supabase.co
# Use your Service Role Key (secret) or Anon Key (public) depending on backend/frontend use
SUPABASE_KEY=your_supabase_api_key_here

# Flask App Secret Key
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_flask_secret_key_here

# Question Encryption Key (32-byte base64 key, e.g. for Fernet symmetric encryption)
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QUESTION_ENCRYPTION_KEY=your_base64_encryption_key_here

# Security Settings
# Set to 'false' for local development (HTTP), 'true' for production (HTTPS)
COOKIE_SECURE=false